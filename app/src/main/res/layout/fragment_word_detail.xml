<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppBaseStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_gradient_background"
            android:elevation="2dp"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RegularRobotoWhite14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word" />

                <TextView
                    android:id="@+id/tvWord"
                    style="@style/BoldRobotoWhite24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Китеп" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/stroked_background"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/llWord">

            <TextView
                android:id="@+id/tvTranslationHeader"
                style="@style/BoldRobotoBlue14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="14dp"
                android:textColor="@color/primary_main"
                android:text="@string/translationHeader"
                app:layout_constraintTop_toBottomOf="@id/llWord" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_marginHorizontal="14dp"
                app:dividerColor="@color/grey_CECECE"
                android:layout_marginVertical="4dp"
                android:layout_height="0.5dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:padding="14dp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvTranslationPlaceholder"
                    style="@style/MediumRobotoBlack18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Generating tranlsation ..."
                    android:textColor="@color/primaryMain"
                    android:textColorHint="@color/grey_AEAEAE"
                    />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/stroked_background"
            app:layout_constraintTop_toBottomOf="@id/llTranslation">

            <TextView
                android:id="@+id/tvExampleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="14dp"
                style="@style/BoldRobotoBlue14"
                android:text="@string/exampleHeader"
                app:layout_constraintTop_toBottomOf="@id/llTranslation" />
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_marginHorizontal="14dp"
                app:dividerColor="@color/grey_CECECE"
                android:layout_marginVertical="4dp"
                android:layout_height="0.5dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvExamplePlaceholder"
                    style="@style/RegularRobotoBlack14"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Generating examples ..."
                    android:textColor="@color/primary_main"
                    android:textColorHint="@color/grey_AEAEAE" />
            </FrameLayout>


        </LinearLayout>



        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
