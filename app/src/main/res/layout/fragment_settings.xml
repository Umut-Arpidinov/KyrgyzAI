<!-- Content -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />


    <LinearLayout
        android:id="@+id/llSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/gray_rounded_bg"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            style="@style/RegularRobotoBlack14"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:text="App settings" />

        <TextView
            android:id="@+id/tvLanguage"
            style="@style/RegularRobotoBlack18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="App language"
            app:drawableEndCompat="@drawable/ic_forwar_ios" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp" />

        <TextView
            android:id="@+id/tvTheme"
            style="@style/RegularRobotoBlack18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App theme"
            app:drawableEndCompat="@drawable/ic_forwar_ios"
            tools:ignore="ExtraText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llObjectDetection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/gray_rounded_bg"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSettings">

        <TextView
            style="@style/RegularRobotoBlack14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Object detection" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto save object"
            android:textAppearance="@style/RegularRobotoBlack18"
            style="@style/ThumbStyle"
             />
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"

            />


        <com.google.android.material.switchmaterial.SwitchMaterial
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Word of the day notification"
            android:textAppearance="@style/RegularRobotoBlack18"
            style="@style/ThumbStyle"
            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/llAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/gray_rounded_bg"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llObjectDetection">

        <TextView
            style="@style/RegularRobotoBlack14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App settings" />

        <TextView
            android:id="@+id/tvAbout"
            style="@style/RegularRobotoBlack18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="About app"
            app:drawableEndCompat="@drawable/ic_forwar_ios" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp" />

        <TextView
            android:id="@+id/tvFeedback"
            style="@style/RegularRobotoBlack18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedback"
            app:drawableEndCompat="@drawable/ic_forwar_ios" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

