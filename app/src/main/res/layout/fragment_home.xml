<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppBaseStyle"
    >

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/llWordOfTheDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_gradient_background"
        android:elevation="2dp"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/RegularRobotoWhite14"
                android:text="Word of the day" />

            <TextView
                android:id="@+id/tvWordOfDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BoldRobotoWhite24"
                tools:text="Китеп" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn more"
            android:background="@drawable/white_rounded_100"
            android:paddingVertical="6dp"
            android:layout_gravity="bottom"
            android:drawablePadding="4dp"
            style="@style/RegularRobotoBlack14"
            android:paddingHorizontal="10dp"
            android:drawableRight="@drawable/ic_next"

            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/llObjecteCount"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="53dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/llWordOfTheDay"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/objectsCount"
                tools:text="12"
                android:background="@drawable/circled_strocked_background"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:elevation="6dp"
                style="@style/BoldRobotBlue24"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Objects detected"
                android:layout_width="wrap_content"
                style="@style/RegularRobotoBlack14"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/wordsCount"
                android:text="0"
                android:background="@drawable/circled_strocked_background"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:elevation="6dp"
                style="@style/BoldRobotBlue24"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Words learned"
                android:layout_width="wrap_content"
                style="@style/RegularRobotoBlack14"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/tvLastDetected"
        android:text="Last detected objects"
        android:layout_width="match_parent"
        style="@style/MediumRobotoBlack20"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="14dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/llObjecteCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/empty_layout"
        android:visibility="gone"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLastDetected"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_word"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLastDetected"
        />

    <ProgressBar
        android:id="@+id/progress"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>
