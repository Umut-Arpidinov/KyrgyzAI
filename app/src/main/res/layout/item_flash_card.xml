<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    android:clipToPadding="false"
    android:foregroundGravity="center">

    <androidx.cardview.widget.CardView
        android:id="@+id/backCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/primaryMain"
        app:cardCornerRadius="@dimen/_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTranslationHeader"
                style="@style/BoldRobotoBlue14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="14dp"
                android:text="@string/translationHeader"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/llWord" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginVertical="4dp"
                app:dividerColor="@color/grey_CECECE" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTranslationPlaceholder"
                    style="@style/MediumRobotoBlack14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textColorHint="@color/grey_AEAEAE" />
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- FRONT SIDE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/frontCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/primaryMain"
        app:cardCornerRadius="@dimen/_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvWord"
                style="@style/BoldRobotoWhite24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>


</FrameLayout>
