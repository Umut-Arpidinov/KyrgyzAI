<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomAppBarTextStyle">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/white</item>
    </style>



    <style name="FloatingActionButtonStyle" parent="Widget.Design.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ButtonRoundedFab</item>
    </style>
    <style name="ButtonRoundedFab" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>


    <style name="Theme.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/selector_button</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="AppBaseStyle">
        <item name="android:background">@color/white</item>
    </style>


    <style name="ThumbStyle">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/switch_track_selector</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:theme">@style/Theme.KyrgyzLerning</item>
        <item name="bottomSheetStyle">@style/ModayStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="ModayStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>